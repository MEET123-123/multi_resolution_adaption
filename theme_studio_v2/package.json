{
  "name": "theme-studio-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Lockscreen-first responsive theme studio for HarmonyOS / EMUI theme packages",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "npx --yes prettier@3.6.2 --write src",
    "format:check": "npx --yes prettier@3.6.2 --check src",
    "test": "vitest run",
    "cli": "tsx src/cli/cli.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
